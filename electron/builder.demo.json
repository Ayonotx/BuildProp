{
    "appId": "com.buildprop.demo",
    "productName": "BuildProp Demo",
    "directories": {
        "output": "../dist/demo"
    },
    "files": [
        "main.js",
        "wrapper.js",
        "package.json"
    ],
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": "x64"
            }
        ],
        "icon": "../public/favicon.ico"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true
    },
    "extraResources": [
        {
            "filter": [
                "**/*"
            ],
            "from": "../.next/standalone",
            "to": ".next/standalone"
        },
        {
            "to": "ai/ollama.exe",
            "from": "resources/ai/ollama.exe"
        },
        {
            "to": "ai/models",
            "from": "resources/ai/models"
        },
        {
            "to": "ai/lib",
            "from": "resources/ai/lib"
        }
    ]
}
