{
    "appId":  "com.buildprop.app",
    "productName":  "BuildProp",
    "directories":  {
                        "output":  "../dist/standard"
                    },
    "files":  [
                  "main.js",
                  "wrapper.js",
                  "package.json"
              ],
    "win":  {
                "target":  [
                               {
                                   "target":  "nsis",
                                   "arch":  "x64"
                               }
                           ],
                "icon":  "../public/favicon.ico"
            },
    "nsis":  {
                 "oneClick":  false,
                 "allowToChangeInstallationDirectory":  true,
                 "createDesktopShortcut":  true,
        "shortcutName":  "BuildProp"
             },
    "extraResources":  [
                           {
                               "filter":  [
                                              "**/*"
                                          ],
                               "from":  "../.next/standalone",
                               "to":  ".next/standalone"
                           }
                       ]
}
